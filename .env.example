# Configure locally in .env.local or in Vercel Environment Variables. Never commit a real key.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
# Required for production API rate limiting (Upstash Redis REST credentials).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
